# Messaging providers. Copy these keys to .env and enter real credentials there.
# Allowed providers: thrivevas | africastalking | none
USSD_PROVIDER=none
SMS_PROVIDER=none

# ThriveVAS SMS: use a fixed key OR account credentials that generate/refresh one.
THRIVEVAS_API_KEY=
THRIVEVAS_MSISDN=
THRIVEVAS_PASSWORD=
THRIVEVAS_KEY_LIFETIME=86400
THRIVEVAS_IDENTITY_URL=https://identity.thrivevas.com/v1/auth/api-key/generate
THRIVEVAS_SMS_URL=https://sms.thrivevas.com/v1/message/send
THRIVEVAS_SENDER_ID=ThriveVas
THRIVEVAS_USSD_FIELD_SESSION=sessionId
THRIVEVAS_USSD_FIELD_PHONE=phoneNumber
THRIVEVAS_USSD_FIELD_TEXT=text
THRIVEVAS_USSD_FIELD_CODE=serviceCode
THRIVEVAS_USSD_INPUT=cumulative
THRIVEVAS_USSD_REPLY=prefix

# Africa's Talking SMS/USSD.
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
AT_ENV=sandbox

# Callback security and diagnostics.
TELCO_CALLBACK_TOKEN=
TELCO_ALLOWED_IPS=
TELCO_CALLBACK_BASE_URL=
TELCO_DEBUG=0
